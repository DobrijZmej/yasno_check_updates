# Налаштування для yasno_check_updates
# Скопіюйте цей файл в .env та заповніть справжніми значеннями

# API URL для YASNO (новий API)
YASNO_URL=https://app.yasno.ua/api/blackout-service/public/shutdowns/regions/25/dsos/902/planned-outages

# API URL для ДТЕК (альтернативне джерело даних)
DTEK_URL=https://kit.uca.co.ua/dtek_parsed.json

# Telegram Bot налаштування
BOT_TOKEN=your_telegram_bot_token_here
# Основний чат
CHAT_ID=your_chat_id_here
# Додаткові чати (розділені комами, необов'язково)
ADDITIONAL_CHAT_IDS=chat_id_1,chat_id_2,chat_id_3

# Налаштування локації
# CITY більше не використовується (залишено для сумісності)
CITY=kiev
# GROUP: нова система груп з підгрупами
# Доступні групи: 1.1, 1.2, 2.1, 2.2, 3.1, 3.2, 4.1, 4.2, 5.1, 5.2, 6.1, 6.2
GROUP=6.2

# Логування
LOG_LEVEL=INFO
LOG_FILE=yasno_bot.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# Інтервал перевірки (секунди)
CHECK_INTERVAL=58

# Зовнішній API для синхронізації даних (необов'язково)
EXTERNAL_API_URL=https://akadem-svitlo.kiev.ua/api/update/schedule
EXTERNAL_API_TOKEN=your_api_token_here